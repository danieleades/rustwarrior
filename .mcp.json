{
  "mcpServers": {
    "rustwarrior": {
      "type": "stdio",
      "command": "cargo",
      "args": [
        "run",
        "-r",
        "--manifest-path",
        "${PWD}/Cargo.toml",
        "--bin",
        "rw",
        "--features",
        "mcp",
        "--",
        "mcp"
      ],
      "env": {
        "RUSTWARRIOR_DATA_DIR": "${PWD}/.rustwarrior"
      }
    }
  }
}
